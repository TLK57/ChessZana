{
  "name": "chesszana",
  "version": "0.1.0",
  "description": "ChessZana : analyse locale de parties d'échecs (chess.com, Lichess, PGN) avec Stockfish 19",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/start.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "test:integration": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "test:record": "node --disable-warning=ExperimentalWarning scripts/record-fixtures.js",
    "smoke": "node scripts/smoke.js",
    "install-engine": "node --disable-warning=ExperimentalWarning src/engine/install.js",
    "update-openings": "node --disable-warning=ExperimentalWarning scripts/update-openings.js",
    "fit-curves": "node --disable-warning=ExperimentalWarning scripts/fit-curves.js",
    "compare-chesscom": "node --disable-warning=ExperimentalWarning scripts/compare-chesscom.js",
    "ajuster-chesscom": "node --disable-warning=ExperimentalWarning scripts/ajuster-chesscom.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1"
  }
}
